{
  "name": "punichess",
  "version": "0.1.0",
  "description": "Play a bot that errs on purpose, and get stopped the moment you miss it.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toby-bro/punichess.git"
  },
  "homepage": "https://punichess.toby.re",
  "scripts": {
    "vendor": "node scripts/vendor-engine.mjs",
    "dev": "npm run vendor && vite",
    "build": "npm run vendor && vite build",
    "preview": "vite preview --host --port 4173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint --fix .",
    "test": "node --test 'src/**/*.test.ts'",
    "test:watch": "node --test --watch 'src/**/*.test.ts'",
    "test:coverage": "node --test --experimental-test-coverage 'src/**/*.test.ts'",
    "test:engine": "node scripts/smoke.mjs",
    "check": "npm run lint && npm run typecheck && npm run test",
    "bench": "node scripts/timing.mjs"
  },
  "license": "GPL-3.0-or-later",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.5.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0"
  },
  "dependencies": {
    "chessground": "^9.2.1",
    "chessops": "^0.15.1",
    "stockfish": "^18.0.8"
  },
  "private": true
}
